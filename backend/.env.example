# Server Port
PORT=5000

# Client Origins for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# LiveKit Configuration
# For LiveKit Cloud: wss://<your-project-id>.livekit.cloud
# For Local / Self-Hosted: ws://localhost:7880
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
